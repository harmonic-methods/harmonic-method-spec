# Harmonic Methods Site Environment Configuration
# Copy to .env.local and fill in values

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Scope to Production in Vercel.
# Leave unset in local/preview to avoid polluting analytics with dev traffic.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=

# Feature Flags (Vercel Flags — @flags-sdk/vercel)
# A linked Vercel deployment uses VERCEL_OIDC_TOKEN automatically.
# Run `vercel env pull` after linking the project to populate these automatically.
# FLAGS is the SDK key for the Vercel Flags service.
# FLAGS_SECRET is used by the Flags Explorer in the Vercel Toolbar.
# Homepage section flags all default to false, so the site renders correctly
# without these set — the gated sections simply stay hidden.
FLAGS=
FLAGS_SECRET=

# Newsletter form POST target (e.g. a Substack/Mailchimp embed endpoint).
# Required before enabling the `homepage-newsletter-section` flag — without it
# the form stays hidden.
NEXT_PUBLIC_NEWSLETTER_ACTION=

# Verified public HTTPS URL for the versioned starter-kit ZIP.
STARTER_KIT_DOWNLOAD_URL=
