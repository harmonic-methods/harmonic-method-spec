    "remark": "^15.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx": "^3.1.1",
    "unist-util-visit": "^5.1.0",
    "flags": "^4.2.0",
    "@flags-sdk/vercel": "^1.4.2",
    "@next/third-parties": "16.3.3",
    "@fontsource-variable/inter": "^5.2.0",
